{
	"name": "vahrplan",
	"version": "6.0.4",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file=.env build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && eslint . --max-warnings 0 --report-unused-disable-directives",
		"lint:fix": "svelte-kit sync && npm run lint -- --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"test": "NODE_OPTIONS=\"--no-webstorage\" vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.3",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/eslint": "^9.6.1",
		"@types/hafas-client": "^6.3.1",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.70.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"leaflet": "^1.9.4",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.55.7",
		"svelte-check": "^4.7.7",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"dependencies": {
		"@motis-project/motis-fptf-client": "^6.7.1",
		"db-vendo-client": "^6.11.3",
		"hafas-client": "^6.3.6",
		"leaflet": "^1.9.4",
		"redis": "^6.3.1"
	}
}
