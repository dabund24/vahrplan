{
	"name": "vahrplan",
	"version": "5.2.3",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file=.env build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && eslint . --max-warnings 0 --report-unused-disable-directives",
		"lint:fix": "svelte-kit sync && npm run lint -- --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"test": "NODE_OPTIONS=\"--no-webstorage\" vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/eslint": "^9.6.1",
		"@types/hafas-client": "^6.3.1",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.2",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.0.1",
		"leaflet": "^1.9.4",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"type": "module",
	"dependencies": {
		"@motis-project/motis-fptf-client": "^6.6.1",
		"db-vendo-client": "^6.11.3",
		"hafas-client": "^6.3.6",
		"leaflet": "^1.9.4",
		"redis": "^6.2.1"
	}
}
